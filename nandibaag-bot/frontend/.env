# VITE_API_URL and VITE_SOCKET_URL are commented out so that the app uses relative paths
# and relies on Vite's proxy (in development) or the same domain (in production).
# This prevents CORS errors and issues when accessing via mobile/LAN IP.
# VITE_API_URL=http://localhost:7000/api
# VITE_SOCKET_URL=http://localhost:7000
