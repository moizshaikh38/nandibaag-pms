# Production environment for Vercel deployment
# These values are baked into the frontend bundle at build time by Vite.
# They contain no secrets — secrets stay in Vercel Dashboard → Environment Variables.

# Express API base URL (Vite replaces import.meta.env.VITE_API_URL at build time)
VITE_API_URL=https://api.nandibaag.shop/api

# Socket.IO server root URL (no /api suffix — socket.io-client connects at the root)
VITE_SOCKET_URL=https://api.nandibaag.shop
