# ══════════════════════════════════════════════════════════════════════
# Nandibaag PMS Backend — Environment Variables
# Copy this file to `.env` and fill in your real values.
# ══════════════════════════════════════════════════════════════════════

# MongoDB connection string
MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/nandibaag-pms?retryWrites=true&w=majority

# JWT
JWT_SECRET=super-secret-jwt-key-nandibaag-prod-2026-x9k2
JWT_EXPIRES_IN=7d

# Server
PORT=7000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Resort contact numbers (used for fallbacks)
RESORT_CONTACT_1=+919257657665
RESORT_CONTACT_2=+919257657664
RESORT_CONTACT_3=+919257657663

# AI providers (OpenRouter / Groq / Gemini / Cerebras / Cloudflare / Ollama)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=openai/gpt-4o-mini
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_TEST_MODE=false

# Admin default credentials (first-run bootstrap only)
ADMIN_DEFAULT_EMAIL=admin@nandibaag.com
ADMIN_DEFAULT_PASSWORD=admin12345

# ── Fast2SMS WhatsApp Business Channel (REQUIRED for this channel) ─────
# This is an ADDITIONAL channel that runs in parallel with the existing
# WhatsApp Web (Baileys) integration. Both channels work simultaneously.
#
# API key from your Fast2SMS dashboard (Dev API section).
FAST2SMS_API_KEY=
#
# Send endpoint discovered from Fast2SMS docs (POST /dev/whatsapp-session).
# Free-form text replies are allowed inside the 24h customer-service window.
FAST2SMS_API_URL=https://www.fast2sms.com/dev/whatsapp-session
#
# Comma-separated WhatsApp Business numbers configured on your Fast2SMS
# account. Used to route replies to the correct sender number.
FAST2SMS_SENDER_NUMBERS=9257657664,9257657663
#
# Meta-style phone number ID of the sender (NOT the phone number itself).
# Find it in the Fast2SMS dashboard (Get Phone Numbers API). If empty, the
# first sender number is used as a fallback (may fail — set this if sends fail).
FAST2SMS_PHONE_NUMBER_ID=
#
# Generate a random string for webhook verification (e.g. openssl rand -hex 32).
# The Fast2SMS dashboard may not support sending this secret; it is used to
# reject unauthenticated webhook hits where possible.
FAST2SMS_WEBHOOK_SECRET=
